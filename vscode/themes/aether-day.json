    {
      "name": "Reading and punctuation",
      "scope": [
        "punctuation",
        "variable",
        "meta.embedded"
      ],
      "settings": {
        "foreground": "#17263a",
        "fontStyle": ""
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#4f6178",
        "fontStyle": ""
      }
    },
    {
      "name": "Keywords and storage",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#6447a0",
        "fontStyle": ""
