#!/usr/bin/env python3
"""Cyberpunk wifi popout menu (waybar network module on-click).

Uses NetworkManager on the system bus for wlan0. An asynchronous SecretAgent
supplies missing wireless passwords while GTK continues dispatching events.
NetworkManager stores system-owned secrets; this menu is not a keyring.
Only one popout at a time: flock on $XDG_RUNTIME_DIR/wifi-menu.lock.
"""

