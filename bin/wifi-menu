# Native dbus-python GLib adapter, needed to dispatch SecretAgent callbacks.
from dbus.mainloop.glib import DBusGMainLoop
DBusGMainLoop(set_as_default=True)
import dbus
import dbus.service

sys.path.insert(0, str(Path(__file__).parent))
