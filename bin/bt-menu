#!/usr/bin/env python3
"""Cyberpunk bluetooth popout menu (waybar bluetooth module on-click).

Talks straight to bluez over D-Bus (org.bluez) -- same approach as
wifi-menu talks to iwd, just a different backend. Devices, pairing,
connect/disconnect/forget and adapter power are all real D-Bus calls;
nothing shells out to bluetoothctl.

Pairing confirmation is handled by registering ourselves as an
org.bluez.Agent1 (capability "KeyboardDisplay"). bluez calls back into
BtAgent while our Pair() call is in flight; RequestConfirmation /
RequestAuthorization / AuthorizeService auto-accept ("just works" /
numeric-comparison flow -- the overwhelmingly common case for phones,
headphones, and other modern peripherals), while RequestPinCode /
RequestPasskey pop a modal GTK entry dialog for the rare device that
needs a code typed in. Pair() runs on a background thread for the same
reason wifi-menu's Connect() does: the callback needs the main thread's
GLib loop free to dispatch it.

Only one popout at a time: an flock on $XDG_RUNTIME_DIR/bt-menu.lock
makes a second click while one is open a no-op instead of stacking
windows.
"""

import fcntl
import os
import sys
import threading
from pathlib import Path

import gi
gi.require_version("Gtk", "3.0")
gi.require_version("GtkLayerShell", "0.1")
gi.require_version("Gdk", "3.0")
from gi.repository import Gtk, Gdk, GLib, GtkLayerShell, Pango

from dbus.mainloop.glib import DBusGMainLoop
DBusGMainLoop(set_as_default=True)
import dbus
import dbus.service

sys.path.insert(0, str(Path(__file__).parent))
from _cyber_particles import install_particles
from _cyber_theme import (
    rgba, scanline_background, chromatic_shadow,
    BG, BG_CARD, BG_HOT, FG, ACCENT, ACCENT2, PURPLE, MUTED, LINE,
    FONT_HEAD, FONT_BODY, PULSE_TIMING, pulse_keyframes, blink_keyframes,
)

BLUEZ = "org.bluez"
AGENT_PATH = "/org/bluez/agent/bt_menu"
AGENT_IFACE = "org.bluez.Agent1"
AGENT_CAPABILITY = "KeyboardDisplay"

SCAN_SECONDS = 8

CARD_W = 480
ROW_H = 58

