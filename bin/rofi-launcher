#!/usr/bin/env python3
"""Instrument/Score Aether application launcher.

Native search and stable category lanes are supplied by _aether_score.
Discovery follows GLib's desktop-entry visibility, locale and override rules.
"""

import json
import os
import subprocess
import sys
from pathlib import Path

# Include Flatpak exports even in desktop sessions started before Flatpak was
# installed. gtk-launch and GTK icon lookup inherit these same data paths.
_data_home = Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local/share")
_data_dirs = list(dict.fromkeys([
    str(_data_home / "flatpak/exports/share"),
    "/var/lib/flatpak/exports/share",
    *(os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share").split(":"),
]))
os.environ["XDG_DATA_DIRS"] = ":".join(_data_dirs)

sys.path.insert(0, str(Path(__file__).parent))
import _aether_score as cc
from gi.repository import Gio

CACHE_FILE = Path.home() / ".cache" / "rofi-launcher-recent"
MAX_RECENT = 8

CATEGORY_DEFS = [
    ("Development", {
        "Development", "IDE", "TextEditor", "Debugger", "RevisionControl",
        "WebDevelopment", "Programming", "Building",
    }),
    ("Game", {
        "Game", "ActionGame", "AdventureGame", "ArcadeGame", "BoardGame",
        "BlocksGame", "CardGame", "LogicGame", "RolePlaying", "Shooter",
        "Simulation", "SportsGame", "StrategyGame",
    }),
    ("Graphics", {
        "Graphics", "2DGraphics", "3DGraphics", "Photography", "Scanning",
        "ImageProcessing", "VectorGraphics", "Viewer", "RasterGraphics",
    }),
    ("Network", {
        "Network", "WebBrowser", "Email", "InstantMessaging", "IRCClient",
        "Chat", "VideoConference", "FileTransfer", "P2P", "RemoteAccess",
        "News",
    }),
    ("AudioVideo", {
        "AudioVideo", "Audio", "Video", "Midi", "Mixer", "Sequencer",
        "Player", "Recorder", "Music", "DiscBurning",
    }),
    ("Office", {
        "Office", "Spreadsheet", "WordProcessor", "Presentation", "Calendar",
        "ContactManagement", "ProjectManagement", "Finance", "Database",
        "Publishing",
    }),
    ("System", {
        "System", "FileManager", "TerminalEmulator", "SystemSettings",
        "PackageManager", "Monitor", "Security", "Archiving", "Compression",
        "HardwareSettings", "Printing",
    }),
]
CATEGORY_LABELS = {"Game": "Games", "AudioVideo": "Audio & video"}


def load_desktop_files() -> list[dict]:
    """Use the same XDG identities and visibility rules as gtk-launch/GLib.

    This handles Hidden overrides, NoDisplay, OnlyShowIn/NotShowIn, TryExec,
    nested desktop IDs and localized display names without a second parser.
    """
    apps = []
    for entry in Gio.AppInfo.get_all():
        if not isinstance(entry, cc.DesktopAppInfo) or not entry.should_show():
            continue
        identifier = entry.get_id()
        if not identifier:
            continue
        apps.append({
            "name": entry.get_display_name() or entry.get_name(),
            "icon": cc.icon_identifier(entry.get_icon()),
            "categories": {c for c in (entry.get_categories() or "").split(";") if c},
            "desktop": identifier.removesuffix(".desktop"),
            "description": entry.get_description() or "",
            "keywords": list(entry.get_keywords() or []),
        })
    return apps


def categorize(apps: list[dict]) -> dict[str, list[dict]]:
    buckets: dict[str, list[dict]] = {name: [] for name, _ in CATEGORY_DEFS}
    buckets["Other"] = []
    assigned: set[str] = set()
    for cat_name, keywords in CATEGORY_DEFS:
        for app in apps:
            if app["desktop"] in assigned:
                continue
            if app["categories"] & keywords:
                buckets[cat_name].append(app)
                assigned.add(app["desktop"])
    for app in apps:
        if app["desktop"] not in assigned:
            buckets["Other"].append(app)
    for cat in buckets:
        buckets[cat].sort(key=lambda a: a["name"].casefold())
    return buckets


def load_recent() -> list[str]:
    if CACHE_FILE.exists():
        try:
            data = json.loads(CACHE_FILE.read_text())
            if isinstance(data, list):
                return [str(x) for x in data[:MAX_RECENT]]
        except Exception:
            pass
    return []


def save_recent(desktop: str, current: list[str]) -> None:
    updated = [r for r in current if r != desktop]
    updated.insert(0, desktop)
    updated = updated[:MAX_RECENT]
    CACHE_FILE.parent.mkdir(parents=True, exist_ok=True)
    CACHE_FILE.write_text(json.dumps(updated))


def build_tabs() -> tuple[list, list]:
    apps = load_desktop_files()
    buckets = categorize(apps)
    recent = load_recent()
    by_stem = {a["desktop"]: a for a in apps}
    category_by_id = {app["desktop"]: CATEGORY_LABELS.get(category, category)
                      for category, entries in buckets.items() for app in entries}

    def row(app):
        return (app["icon"], app["name"], app["desktop"], {
            "category": category_by_id[app["desktop"]],
            "description": app.get("description", ""),
            "keywords": app.get("keywords", []),
        })

    tabs = []
    recent_apps = [by_stem[r] for r in recent if r in by_stem]
    tabs.append(("All", [row(a) for a in sorted(apps, key=lambda a: a["name"].casefold())]))
    if recent_apps:
        tabs.append(("Recent", [row(a) for a in recent_apps]))
    for cat_name, _ in CATEGORY_DEFS:
        if buckets.get(cat_name):
            tabs.append((CATEGORY_LABELS.get(cat_name, cat_name), [row(a) for a in buckets[cat_name]]))
    if buckets.get("Other"):
        tabs.append(("Other", [row(a) for a in buckets["Other"]]))
    return tabs, recent


def main():
    tabs, recent = build_tabs()

    def on_activate(desktop: str):
        save_recent(desktop, recent)
        subprocess.Popen(
            ["gtk-launch", desktop],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )

    cc.run("Apps", tabs, on_activate,
           "alt+1-9 jump tab   ctrl+tab / ctrl+shift+tab cycle   ↑/↓ select   Enter open   type to search")


if __name__ == "__main__":
    main()
